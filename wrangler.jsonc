{
  // Cấu hình Cloudflare Worker "farmbase-website": trang tĩnh trong site/, API trong worker/index.js, cơ sở dữ liệu D1 "farmbase".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farmbase-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/chien-dich-10000ha/*", "/api/*", "/bai-viet/*", "/sitemap.xml"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "farmbase", "database_id": "708142ad-4dfe-46b7-ae7d-b3a0c35f15f5" }
  ],
  // Giữ các biến đã thêm trên trang Cloudflare (ADMIN_TOKEN, RESEND_API_KEY, LEAD_EMAIL_TO...) khi đăng bản mới
  "ai": { "binding": "AI" },
  "keep_vars": true,
  "observability": { "enabled": true }
}
